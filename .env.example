# =============================================================================
# .env.example — credential TEMPLATE for agent-atlas-growth-department
# =============================================================================
#
# READ THIS FIRST
#
# 1. NOTHING HERE IS CONNECTED. Every service listed below has status
#    NOT CONNECTED as of 2026-07-28. This file is a forward-looking template
#    describing credentials the project will EVENTUALLY need. It is not a
#    description of working configuration. No account, key, token, project,
#    or API access referenced below is known to exist or to be authorized.
#
# 2. THIS FILE IS COMMITTED TO GIT. `.env` IS NOT, AND MUST NEVER BE.
#    `.env` is git-ignored (verified 2026-07-28: `git check-ignore -v .env`
#    matched `.gitignore:27`). If you ever find `.env` staged, stop and remove
#    it before committing.
#
# 3. WHERE REAL VALUES GO (per `user-guide/USER_INSTRUCTIONS.md`):
#      - Local development ... `.env` in this folder, never committed
#      - Production ........... Google Secret Manager
#      - This file ............ placeholder variable NAMES only
#    Never paste a secret into a prompt, Markdown file, Google Doc, Google
#    Sheet, GitHub, a screenshot, or chat.
#
# 4. NO `.env` FILE EXISTS YET and Phase 01 does not create one. Creating it
#    is a later-phase action that must not happen before a secrets policy
#    exists (see "BEFORE ANY CREDENTIAL IS INTRODUCED" at the bottom).
#
# 5. PLACEHOLDER STYLE. Values are either empty (`VAR=`) or the literal
#    marker `<obtain-from-owner-do-not-commit>`. Deliberately NO
#    realistic-looking fake keys — a fake key shaped like a real one trips
#    secret scanners and teaches the wrong habit.
#
# Variables are grouped by the PHASE that will own them. A phase that has not
# run yet owns nothing; its group is here so nobody invents a credential
# ad hoc when that phase arrives.
# =============================================================================


# -----------------------------------------------------------------------------
# PHASE 05 — Google Drive / Docs / Sheets  ......  STATUS: BLOCKED (Q-004)
# -----------------------------------------------------------------------------
# Phase 05 builds the Google Drive "living document control center".
# Q-004 (Google Drive folder location and access) is the project's ONLY
# BLOCKED open question. It requires Project Owner action before Phase 05 can
# begin. Nothing in this group can be filled in until Q-004 is answered.
# Google Cloud SDK (`gcloud`) is NOT installed on this machine — see README
# "Verified environment". Phase 02 owns whether that changes.

# Absolute path to a Google service-account JSON key file on the local disk.
# Owner: Phase 05.  Status: NOT CONNECTED.
# The key FILE ITSELF must live outside the repository, or in a git-ignored
# path. Never commit a service-account JSON. This variable holds a PATH, not
# a key — but the file it points at is a secret.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Cloud project that owns the Drive/Docs/Sheets API access and, later,
# the scheduled automation (Phase 19).
# Owner: Phase 05.  Status: NOT CONNECTED — no Google Cloud project is known
# to exist for this work. Do not invent an ID.
GOOGLE_CLOUD_PROJECT_ID=

# Google Drive folder ID for the control center.
# Owner: Phase 05.  Status: BLOCKED on Q-004 — the folder location and access
# arrangement are undecided. This is the single blocked item in the project.
# Leave empty until the owner resolves Q-004. Do not guess a folder ID.
GDRIVE_CONTROL_CENTER_FOLDER_ID=

# OAuth client credentials, if Phase 05 chooses a user-consent flow instead of
# a service account. Which of the two is used is NOT decided.
# Owner: Phase 05.  Status: NOT CONNECTED.
# Production OAuth consent is a human checkpoint — the Project Owner performs
# it personally (`user-guide/USER_INSTRUCTIONS.md`).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=<obtain-from-owner-do-not-commit>


# -----------------------------------------------------------------------------
# PHASE 16 — Publishing and scheduling adapters  ....  STATUS: CANDIDATE ONLY
# -----------------------------------------------------------------------------
# READ THIS BEFORE FILLING IN ANYTHING BELOW:
#
#   * NO PLATFORM IS SELECTED. Per D-017, Facebook, Instagram, WhatsApp, and
#     TikTok are CANDIDATE platforms of early owner interest — directional
#     input only. They are not a locked rollout order, not a launch
#     commitment, and not a complete candidate set. Phase 10 selects
#     platforms; Q-002 (final rollout order) is UNRESOLVED.
#   * NO ACCOUNT STATUS IS KNOWN. Q-005 (existing social account status) is
#     UNRESOLVED. It is not known whether any account exists, who controls it,
#     or whether API access is available or permitted on any of these
#     platforms. Nothing here asserts that a platform supports a given
#     integration.
#   * Account creation, platform terms acceptance, identity/phone
#     verification, and production OAuth consent are HUMAN CHECKPOINTS. The
#     Project Owner completes them personally.
#   * Publishing itself starts at DISABLED on the D-010 maturity ladder.
#
# The variables below are placeholders for CANDIDATES ONLY, so that if and
# when a platform is selected, its credential name already has a home.

# --- Facebook (candidate only, per D-017) --- Owner: Phase 16. NOT CONNECTED.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=<obtain-from-owner-do-not-commit>
FACEBOOK_PAGE_ACCESS_TOKEN=<obtain-from-owner-do-not-commit>

# --- Instagram (candidate only, per D-017) --- Owner: Phase 16. NOT CONNECTED.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=<obtain-from-owner-do-not-commit>

# --- WhatsApp (candidate only, per D-017) --- Owner: Phase 16. NOT CONNECTED.
# Community messaging via WhatsApp would also touch Phase 17 (lead routing)
# and Q-009 (data-privacy handling), which is UNRESOLVED.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=<obtain-from-owner-do-not-commit>

# --- TikTok (candidate only, per D-017) --- Owner: Phase 16. NOT CONNECTED.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=<obtain-from-owner-do-not-commit>
TIKTOK_ACCESS_TOKEN=<obtain-from-owner-do-not-commit>


# -----------------------------------------------------------------------------
# PHASE 18 — Analytics, attribution, and revenue data  ...  STATUS: NOT CONNECTED
# -----------------------------------------------------------------------------

# Stripe API key — READ-ONLY.
# Owner: Phase 18.  Status: NOT CONNECTED.
# READ-ONLY IS NOT A PREFERENCE, IT IS THE REQUIREMENT. This project reads
# revenue data for attribution. It must never hold a key that can create,
# modify, refund, or transfer anything. Use a Stripe restricted key with read
# scopes only.
# No Stripe access exists today, and none is authorized today. Obtaining a key
# is a Project Owner action (account-level + spending-adjacent). Do not create
# one on the owner's behalf.
STRIPE_READ_ONLY_API_KEY=<obtain-from-owner-do-not-commit>

# Optional analytics property identifier, if Phase 18 selects a web-analytics
# source. No source is selected. Owner: Phase 18. Status: NOT CONNECTED.
# Q-003 (numeric KPIs/targets) is UNRESOLVED, so what would be measured is
# itself undecided.
ANALYTICS_PROPERTY_ID=


# -----------------------------------------------------------------------------
# PHASE 17 / 18 — Email and CRM  .................  STATUS: NOT CONNECTED
# -----------------------------------------------------------------------------
# Generic placeholders. NO email provider and NO CRM has been selected; these
# names are intentionally vendor-neutral. Phase 17 owns community messaging
# and lead routing; Phase 18 owns analytics over the resulting data.
# Q-009 (data-privacy handling for lead/contact data) is UNRESOLVED, and
# `data/private/` is git-ignored pre-emptively because of it (D-033).
# Direct outreach and responses to complaints are HUMAN CHECKPOINTS.

# Transactional/marketing email provider. Owner: Phase 17. NOT CONNECTED.
EMAIL_PROVIDER_API_KEY=<obtain-from-owner-do-not-commit>
EMAIL_FROM_ADDRESS=

# CRM / contact store. Owner: Phase 17. NOT CONNECTED.
CRM_API_KEY=<obtain-from-owner-do-not-commit>
CRM_BASE_URL=


# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT — non-secret settings  ........  STATUS: SAFE DEFAULTS
# -----------------------------------------------------------------------------
# These are NOT secrets. They are behaviour switches, and the defaults below
# are the safe ones. Copy them as-is.

# Logging verbosity. Owner: local. One of: debug | info | warn | error.
LOG_LEVEL=info

# Master simulation switch. `true` means: take no outward-facing action —
# no publish, no send, no write to any external service.
# THE CORRECT DEFAULT IS `true`. Architecture Rule 10 / D-010 start every
# production-facing capability at DISABLED, then SIMULATION. Nothing in this
# project has advanced past those stages, so a `DRY_RUN=false` local
# environment would be ahead of the approved capability state.
# Changing this to `false` is not a local convenience — it is a capability
# promotion and belongs to whichever phase owns that capability.
DRY_RUN=true

# Environment label used for logging/audit context only. Not a secret.
APP_ENV=local


# =============================================================================
# BEFORE ANY CREDENTIAL IS INTRODUCED
# =============================================================================
# There is no `SECURITY_POLICY.md` in this project yet (D-027, D-035). Phase 03
# owns writing it; Phase 01 deliberately does not. Per D-027, a secrets-handling
# policy must exist BEFORE any credential is introduced.
#
# So: do not populate a real `.env` and do not request any key from the Project
# Owner until that policy exists. If a phase needs a credential sooner, that is
# a decision to escalate, not a step to skip.
#
# If a secret is ever committed by accident: treat it as compromised, rotate it
# at the provider, and report it. Deleting the file in a later commit does not
# remove it from history.
# =============================================================================
